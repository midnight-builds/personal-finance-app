{
  "name": "@finance-app/shared",
  "private": true,
  "type": "module",
  "description": "Contracts and privacy helpers shared by the API, the MCP server and the web UI",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.15.7",
    "typescript": "^5.6.2"
  }
}
