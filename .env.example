# Copy this file to .env and fill in your own values.
# No real secrets belong in this file or in git.

# --- AI (OpenAI) ---
# Required for AI features (Copilot, categorization, rule suggestions).
# Without it the app still runs as a manual browser/editor, with AI disabled.
OPENAI_API_KEY=

# Model used for AI calls. Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# SQLite file path. Optional; defaults to apps/api/data/finance.db.
# DB_PATH=apps/api/data/finance.db

# --- API server ---
# Optional; defaults shown. The API has no authentication: keep HOST on loopback
# unless every host on the network is trusted. Note that the web UI (Vite, port
# 5173) proxies /api to the API, so anyone who can reach the UI can also call the
# API through it; restrict the UI port the same way.
# PORT=3001
# HOST=127.0.0.1

# --- MCP server (apps/mcp) ---
# Options for external AI agents; see docs/MCP.md. Keep secrets in files, not here.
# FINANCE_API_URL=http://127.0.0.1:3001
# MCP_TRANSPORT=stdio            # stdio | http
# MCP_HOST=127.0.0.1             # non-loopback requires TLS
# MCP_PORT=3030
# MCP_TOKEN_FILE=/path/to/token  # http: bearer token, >= 32 chars
# MCP_TLS_CERT=/path/to/server.crt
# MCP_TLS_KEY=/path/to/server.key
# MCP_ALLOWED_IPS=192.168.1.20,10.0.0.0/24
# MCP_DISABLED_TOOLS=propose_feature
# MCP_PROPOSAL_SOURCE=hermes
